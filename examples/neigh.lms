# Chapter: Basics - neighbor table (ARP/NDP)
# Shows: net.neighbors, Neighbor.ip/dev/state/mac/family/router/proxy,
#        NeighborList len/at
# Run: lmscript examples/neigh.lms
# Needs: nothing (offline); rtnetlink dumps the kernel neighbor table
#        directly. The table may be empty on a fresh machine, so only the
#        constant lines are asserted.
# exit: 0
# expect:
#|neighbor table
#|neighbor dump complete
p = _lmcode_ cli="lmnet" install="github:lmctl-ai/lmnet@latest";

println("neighbor table");
let neighs = net.neighbors();
println("entries: " + str(neighs.len()));
for (i in range(0, neighs.len())) {
  let n = neighs.at(i);
  let mac = n.mac();
  if (mac == "") { mac = "-"; }
  println("  " + n.ip() + " dev " + n.dev() + " state " + n.state() +
          " lladdr " + mac + " family " + n.family());
}
println("neighbor dump complete");

end _lmcode_
r = run_lmcode(p);
require(r.ok, json_stringify(r));
