# Chapter: Basics - routing tables
# Shows: net.routes, Route.dest/via/dev/proto/scope/metric/table/prefsrc,
#        RouteList len/at, scanning for a default route
# Run: lmscript examples/routes.lms      (then: lmnet --dsl build/routes.dslb)
# Needs: nothing (offline); rtnetlink dumps the kernel tables directly. Route
#        contents vary per host, so only the constant lines are asserted.
# exit: 0
# expect:
#|routes:
#|route dump complete
p = _dsl_ cli="lmnet" install="github:lmctl-ai/lmnet@latest";

println("routes:");
let routes = net.routes();
let have_default = false;
for (i in range(0, routes.len())) {
  let r = routes.at(i);
  let via = r.via();
  if (via == "") { via = "-"; }
  let dev = r.dev();
  if (dev == "") { dev = "-"; }
  println("  [" + r.table() + "] " + r.dest() + " via " + via + " dev " + dev +
          " proto " + r.proto() + " scope " + r.scope() + " metric " + str(r.metric()));
  if (r.dest() == "default") { have_default = true; }
}
if (have_default) {
  println("default route present");
} else {
  println("default route absent");
}
println("route dump complete");

end _dsl_
savedsl(p, "build/routes.dslb");
